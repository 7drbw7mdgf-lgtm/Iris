{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iris",
  "version": "5.2.0",
  "identifier": "com.lshpk18.iris",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Iris — R Graphing Studio",
        "width": 1380,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 lshpk18. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": ["csv", "tsv", "txt"],
        "name": "Tabular Data",
        "description": "Delimited text data file",
        "role": "Viewer",
        "mimeType": "text/csv"
      },
      {
        "ext": ["xls", "xlsx", "xlsm", "xlsb"],
        "name": "Excel Workbook",
        "description": "Microsoft Excel spreadsheet",
        "role": "Viewer",
        "mimeType": "application/vnd.ms-excel"
      },
      {
        "ext": ["R", "r", "Rscript", "rscript"],
        "name": "R Script",
        "description": "R source script",
        "role": "Editor",
        "mimeType": "text/x-r-source"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGOTc3MkZBRTgxMjBDRDEKUldUUkRCTG8rbktYMzNWbjBtWjNlQ3lFNlpkSlBZb0NPTkxsa0ZIdnlQaWMvTnhMSHYrRmdnZEMK",
      "endpoints": [
        "https://github.com/7drbw7mdgf-lgtm/Iris/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
